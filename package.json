{
  "name": "revmatrix-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "generate:batch": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate_synthetic_batch.ts",
    "run:benchmark": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/run_benchmark.ts",
    "generate:data": "tsx scripts/generate_synthetic_batch.ts",
    "benchmark": "tsx scripts/generate_synthetic_batch.ts && tsx scripts/run_benchmark.ts",
    "test:benchmark": "vitest run tests/benchmark/scorer.test.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@prisma/client": "^5.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.439.0",
    "next": "14.2.8",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "jest": "^30.4.2",
    "postcss": "^8.4.45",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.10",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
